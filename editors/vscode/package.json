{
  "name": "thunderlang",
  "displayName": "ThunderLang™",
  "description": "Thunder™, the human programming language, in VS Code. Read and check ThunderLang™ rules: highlighting, live errors, completion, and hover from the same compiler that checks AI changes against your rules. Runs locally, no AI involved.",
  "version": "1.7.0",
  "publisher": "openthunder",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "homepage": "https://thunderlang.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkillsTechTalk/thunderlang.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/SkillsTechTalk/thunderlang/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "thunder",
    "thunder programming language",
    "thunderlang",
    "intent",
    "intent-oriented programming",
    "specification",
    "verification",
    "business rules",
    "ai code review"
  ],
  "activationEvents": [
    "onLanguage:thunder"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "thunder",
        "aliases": [
          "ThunderLang",
          "thunder"
        ],
        "extensions": [
          ".thunder",
          ".tl",
          ".intent"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "thunder",
        "scopeName": "source.thunder",
        "path": "./syntaxes/thunder.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "ThunderLang",
      "properties": {
        "thunderlang.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command or script that provides the ThunderLang language server. Leave empty to auto-detect: a workspace-local `thunder` binary or compiler checkout first, then `thunder` on your PATH. A value ending in `.js`, `.mjs`, or `.cjs` is launched as `node <path> lsp`; any other value is launched as `<command> lsp`."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.4.0"
  }
}
